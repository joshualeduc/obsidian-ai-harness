{
  "$schema": "https://opencode.ai/config.json",
  "formatter": false,
  "lsp": {},
  "agents": {
    "research-assistant": {
      "color": "#4f86f7"
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*01 Projects/*", "effect": "allow" },
    { "action": "edit", "resource": "*02 Literature Notes/*", "effect": "allow" },
    { "action": "edit", "resource": "*03 Drafts/*", "effect": "allow" },
    { "action": "edit", "resource": "*000 Homepage.md", "effect": "allow" },
    { "action": "edit", "resource": "*99 System/AI/*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "deny" }
  ]
}
